# SQLite database file. The path is relative to the prisma folder.
DATABASE_URL="file:./dev.db"

# Used to sign login sessions. Replace with a long random string before use.
# Example (run locally): openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# API port used by the Express server.
PORT=3001

# Vite dev server origin. Required so the browser can send the login cookie.
CLIENT_ORIGIN="http://localhost:5173"

NODE_ENV="development"
