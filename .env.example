# SQLite database file. The path is relative to the prisma folder.
DATABASE_URL="file:./dev.db"

# Used to sign login sessions. Replace with a long random string before use.
# Example (run locally): openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# API port. The office server and the browser use this same port after npm start.
PORT=3001

# Leave unset so the office server accepts connections from other devices on the private network.
# Set 127.0.0.1 to keep the server on this computer only.
# HOST="0.0.0.0"

# Leave unset for the normal internal http:// address.
# Set true only when the app is served over HTTPS.
# COOKIE_SECURE="false"

# Vite development origin. Used only by npm run dev.
CLIENT_ORIGIN="http://localhost:5173"

NODE_ENV="development"
