# Office company database. The path is relative to the prisma folder.
# The file is prisma/production.db. npm run db:office creates it empty.
# Do not point this at prisma/dev.db. That file is only for development.
DATABASE_URL="file:./production.db"

# Used to sign login sessions. Replace with a long random string before use.
# Example (run locally): openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# API port. The office server and the browser use this same port after npm start.
PORT=3001

# Leave unset. The server then accepts this computer and other devices on the private office network.
# It does not store an IP address, and it does not listen on a public internet address.
# Set 127.0.0.1 only if this computer must be the only one that can open the system.
# HOST="127.0.0.1"

# Leave unset for the normal internal http:// address.
# Set true only when the app is served over HTTPS.
# COOKIE_SECURE="false"

# Vite development origin. Used only by npm run dev.
CLIENT_ORIGIN="http://localhost:5173"

NODE_ENV="development"

# Leave unset on the office computer. Do not put the administrator password in this file.
# The office administrator is created with npm run admin:create, which asks for the password
# and stores only a hash. CMH_BIND is not used for the office server.
# CMH_BIND="0.0.0.0"
